{
  "name": "rasad-srm",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.21.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @rasad/cms --filter @rasad/panel dev",
    "dev:cms": "pnpm --filter @rasad/cms dev",
    "dev:panel": "pnpm --filter @rasad/panel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @rasad/cms test:int && pnpm --filter @rasad/panel test",
    "test:int": "pnpm --filter @rasad/cms test:int",
    "test:e2e": "pnpm --filter @rasad/cms test:e2e",
    "generate:types": "pnpm --filter @rasad/cms generate:types",
    "generate:importmap": "pnpm --filter @rasad/cms generate:importmap",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "pnpm --filter @rasad/cms migrate",
    "seed": "pnpm --filter @rasad/cms seed",
    "seed:dev": "pnpm --filter @rasad/cms seed:dev"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}
