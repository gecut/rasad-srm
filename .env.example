# Docker Compose production inputs. Replace OWNER/REPO with the lowercase GitHub path.
CMS_IMAGE=ghcr.io/OWNER/REPO/cms
PANEL_IMAGE=ghcr.io/OWNER/REPO/panel
# Use the same published sha-<full commit SHA> tag for both images.
IMAGE_TAG=sha-REPLACE_WITH_FULL_COMMIT_SHA
DATABASE_URL=postgresql://USER:PASSWORD@postgres-host:5432/rasad_srm
PAYLOAD_SECRET=replace-with-a-long-random-secret
PUBLIC_ORIGIN=https://rasad.example.com
RUN_JOBS=false
SMS_PROVIDER=unconfigured
