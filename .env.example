# Docker Compose production inputs for Dokploy.
# All variables have defaults; override only what is needed for your environment.

CMS_IMAGE=ghcr.io/gecut/rasad-srm/cms
MIGRATION_IMAGE=ghcr.io/gecut/rasad-srm/migration
PANEL_IMAGE=ghcr.io/gecut/rasad-srm/panel
# Tag defaults to 'latest' (or use 'main' or 'sha-<full commit SHA>')
IMAGE_TAG=latest

# Database connection URL (from Dokploy PostgreSQL service or external database)
DATABASE_URL=postgresql://postgres:replace-with-a-long-url-safe-password@postgres:5432/rasad_srm

# Payload secret (must be at least 32 characters long)
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Public CMS origin (e.g. https://api.example.com)
PUBLIC_ORIGIN=https://api.example.com

# Public Panel origin for CORS and CSRF (e.g. https://panel.example.com)
PANEL_ORIGIN=https://panel.example.com

# Root cookie domain for sharing auth session between subdomains (e.g. .example.com)
COOKIE_DOMAIN=.example.com

RUN_JOBS=false
SMS_PROVIDER=unconfigured
