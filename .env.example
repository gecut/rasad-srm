# Docker Compose production inputs for Dokploy.
CMS_IMAGE=ghcr.io/gecut/rasad-srm/cms
PANEL_IMAGE=ghcr.io/gecut/rasad-srm/panel
# Use the same published sha-<full commit SHA> tag for both images.
IMAGE_TAG=sha-REPLACE_WITH_FULL_COMMIT_SHA
# Generate a long URL-safe password (for example, openssl rand -hex 32).
POSTGRES_USER=rasad
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
POSTGRES_DB=rasad_srm
# Keep this name stable across redeploys; use a distinct name for staging.
POSTGRES_VOLUME_NAME=rasad_srm_prod_postgres_data
PAYLOAD_SECRET=replace-with-a-long-random-secret
PUBLIC_ORIGIN=https://rasad.example.com
RUN_JOBS=false
SMS_PROVIDER=unconfigured
