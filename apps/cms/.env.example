# Local development; production values are supplied at container runtime.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/rasad_srm
PAYLOAD_SECRET=replace-with-a-long-random-secret
PUBLIC_ORIGIN=http://localhost:5173
# Migrations are authoritative on persisted databases.
SCHEMA_PUSH=false
# Mock SMS is for local development only.
SMS_PROVIDER=mock
RUN_JOBS=false
